{
	"name": "hexlore-obsidian",
	"version": "0.0.1",
	"private": true,
	"description": "HexLore for Obsidian: hex-crawl map builder, viewer and player server",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"vendor": "node scripts/vendor-from-flutter.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check": "npm run lint && npm test && npm run build"
	},
	"keywords": [],
	"license": "UNLICENSED",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "30.0.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@pdf-lib/upng": "1.0.1",
		"pdf-lib": "1.17.1",
		"perfect-freehand": "1.2.2",
		"qrcode-generator": "1.4.4"
	}
}
